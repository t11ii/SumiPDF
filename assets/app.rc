1 24 "assets/app.manifest"
201 ICON "assets/SumiPDF.ico"

#include <windows.h>
202 DIALOGEX 0, 0, 338, 145
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SumiPDF"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "", 1000, 8, 8, 322, 12
    LISTBOX 1001, 8, 22, 322, 94, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON "", 1002, 8, 123, 72, 15
    DEFPUSHBUTTON "OK", IDOK, 212, 123, 56, 15
    PUSHBUTTON "Cancel", IDCANCEL, 274, 123, 56, 15
END

203 DIALOGEX 0, 0, 245, 74
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SumiPDF"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "", 1000, 8, 7, 229, 12
    EDITTEXT 1001, 8, 21, 229, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 119, 50, 56, 15
    PUSHBUTTON "Cancel", IDCANCEL, 181, 50, 56, 15
END

204 DIALOGEX 0, 0, 312, 237
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Keyboard shortcuts"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Shortcut", -1, 10, 8, 106, 12
    LTEXT "Action", -1, 126, 8, 168, 12
    LISTBOX 1000, 8, 23, 296, 185, LBS_USETABSTOPS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    DEFPUSHBUTTON "Close", IDOK, 248, 215, 56, 15
END
